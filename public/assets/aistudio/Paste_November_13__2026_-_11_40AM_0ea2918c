<!-- Micro-interactions & Category Filtering Vanilla JavaScript -->
<script>
    // Category Filter Interaction
    const filterButtons = document.querySelectorAll('.cat-btn');
    const menuItems = document.querySelectorAll('.menu-item');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const cat = button.getAttribute('data-cat');
        
        // Update active button state
        filterButtons.forEach(btn => {
          btn.classList.remove('bg-primary-container', 'text-surface-container-lowest', 'shadow-sm');
          btn.classList.add('bg-surface-container-lowest', 'text-on-surface-variant', 'border', 'border-outline-variant/40');
        });
        button.classList.add('bg-primary-container', 'text-surface-container-lowest', 'shadow-sm');
        button.classList.remove('bg-surface-container-lowest', 'text-on-surface-variant', 'border-outline-variant/40');

        // Filter items
        menuItems.forEach(item => {
          if (cat === 'all' || item.getAttribute('data-category') === cat) {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });

    // Add To Cart Micro-Feedback
    const addButtons = document.querySelectorAll('.add-to-cart-btn');
    addButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const originalHTML = btn.innerHTML;
        btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">done</span><span>Added</span>';
        btn.classList.add('bg-secondary', 'text-on-secondary');
        setTimeout(() => {
          btn.innerHTML = originalHTML;
          btn.classList.remove('bg-secondary', 'text-on-secondary');
        }, 1400);
      });
    });

    // Custom Cake Toast Confirmation
    function showInquiryToast() {
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-6 right-6 z-50 bg-primary-container text-surface-bright px-6 py-4 rounded-xl shadow-2xl border border-secondary flex items-center gap-3 transition-transform duration-300 transform translate-y-0';
      toast.innerHTML = `
        <span class="material-symbols-outlined text-secondary-container">mark_email_read</span>
        <div>
          <h4 class="font-headline-sm text-sm font-semibold">Inquiry Dispatched!</h4>
          <p class="text-body-sm text-xs text-on-primary-container">Chef will reach out on WhatsApp within 2 hours with sketches & tasting details.</p>
        </div>
      `;
      document.body.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 400);
      }, 4500);
    }
  </script>


